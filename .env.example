# MangaD-Neon Environment Configuration Template

# --- Database Configuration ---
# MANGAD_DATABASE_HOST=127.0.0.1
# MANGAD_DATABASE_PORT=5432
# MANGAD_DATABASE_NAME=mangad
# MANGAD_DATABASE_USER=postgres
# MANGAD_DATABASE_PASSWD=your_password

# --- Service Configuration ---
# MANGAD_SERVICE_HOST=127.0.0.1:6789
# MANGAD_ENABLE_AUTH=false

# --- Crawler Configuration ---
# MANGAD_CRAWLER_SEMAPHORE=10
# MANGAD_CRAWLER_STORAGE=./storage
# MANGAD_CRAWLER_IMAGE_SEMAPHORE=5
# MANGAD_CRAWLER_IMAGE_QUALITY=80.0

# --- Crawler Retry Configuration ---
# MANGAD_RETRY_MAX_RETRIES=5
# MANGAD_RETRY_DELAY=2
# MANGAD_RETRY_MAX_DELAY=30

# --- Search Configuration ---
# MANGAD_SEARCH_HOST=http://127.0.0.1:7700
# MANGAD_SEARCH_API_KEY=your_search_api_key

# --- Thumbnail Configuration ---
# MANGAD_THUMBNAIL_ENABLED=true
# MANGAD_THUMBNAIL_WIDTH=200
# MANGAD_THUMBNAIL_HEIGHT=200
# MANGAD_THUMBNAIL_QUALITY=75.0

# --- Log Configuration ---
# MANGAD_LOG_LEVEL=info

# --- Permissions ---
# MANGAD_ALLOW_REMOTE_VISIT=false

# --- Config Path ---
# MANGAD_CONFIG_PATH=./config/config.toml
